# flicker v2 — peer endpoint config
# Self-loop smoke test: peer publishes to stream1 and reads stream1 from VK's
# HLS output. Use stream2 only if you want to run a second peer in parallel for
# a true bidirectional end-to-end test.

peer_my_rtmp_url=rtmp://vsu.mycdn.me/input
peer_my_stream_key=1125899968137462_1125899968137462_71_lbzkmiuuje
peer_their_vk_channel=pavel8899
peer_their_stream_name=stream1

flicker_modulation_mode=B
flicker_log_every_frame=1

# Second stream key (unused by single-peer self-loop; keep for 2-peer test):
# peer_my_rtmp_url=rtmp://vsu.mycdn.me/input
# peer_my_stream_key=1125899968167671_1125899968167671_71_yvik4q2m5y
# peer_their_vk_channel=pavel8899
# peer_their_stream_name=stream2

# --- v1 legacy keys below (no longer read by v2 binary; kept as reference) ---
# rtmp_server = "rtmp://vsu.mycdn.me/input/"
# stream_resolution = "256x144"          # v2: hard-coded 256x144
# stream_fps = 24                        # v2: hard-coded 24
# cell_size = 4                          # v2: hard-coded 4
# update_every_frames = 1                # v2: every frame (concept removed)
# vk_live_channel = "pavel8899"          # → peer_their_vk_channel
# client_stream_key = "1125899968137462_1125899968137462_71_lbzkmiuuje"  # → peer_my_stream_key
# client_stream_name = "stream1"         # → peer_their_stream_name (for self-loop)
# server_stream_key = "1125899968167671_1125899968167671_71_yvik4q2m5y"
# server_stream_name = "stream2"
